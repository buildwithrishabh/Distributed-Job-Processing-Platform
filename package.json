{
  "name": "distributed-job-processing-platform",
  "version": "1.0.0",
  "description": "High-Throughput Distributed Background Job Processing Platform with Redis, BullMQ, and Modern React Dashboard",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "worker": "npm --prefix backend run worker",
    "build:frontend": "npm --prefix frontend run build",
    "docker:up": "docker-compose -f backend/docker-compose.yml up --build",
    "docker:down": "docker-compose -f backend/docker-compose.yml down",
    "test:load": "npm --prefix backend run test:load",
    "test:load:smoke": "npm --prefix backend run test:load:smoke",
    "test:load:jobs": "npm --prefix backend run test:load:jobs",
    "test:load:rate-limit": "npm --prefix backend run test:load:rate-limit",
    "test:load:idempotency": "npm --prefix backend run test:load:idempotency",
    "test:load:socket": "npm --prefix backend run test:load:socket"
  },
  "keywords": [
    "bullmq",
    "redis",
    "job-queue",
    "distributed-systems",
    "react",
    "dashboard"
  ],
  "author": "",
  "license": "ISC"
}
